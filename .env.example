# Copy to .env for local development (never commit .env).
# EAS preview / production builds take EXPO_PUBLIC_API_URL from eas.json
# and secrets from EAS environment variables.

# Your backend on the LAN (development builds / Expo Go only):
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# Firebase config for push (optional locally; EAS: file variable)
# GOOGLE_SERVICES_JSON=./google-services.json
